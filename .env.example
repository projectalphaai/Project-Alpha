# Server
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# PostgreSQL (required)
# Local Docker: docker compose up -d
# Local install: create DB project_alpha then use your postgres password
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/project_alpha?schema=public"

# Auth (JWT)
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=14d
SESSION_TTL_DAYS=14
AUTH_COOKIE_NAME=pa_session

# Token encryption for OAuth credentials (required in production)
TOKEN_ENCRYPTION_KEY=replace-with-64-hex-chars-or-32-byte-secret

# Meta (Facebook + Instagram Graph API)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0
META_OAUTH_REDIRECT_URI=http://localhost:3000/api/oauth/meta/callback

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
