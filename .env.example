# Server
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# PostgreSQL (required)
# Local Docker: docker compose up -d
# Local install: create DB project_alpha then use your postgres password
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/project_alpha?schema=public"

# Auth (JWT)
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=14d
SESSION_TTL_DAYS=14
AUTH_COOKIE_NAME=pa_session

# Token encryption for OAuth credentials (required in production)
TOKEN_ENCRYPTION_KEY=replace-with-64-hex-chars-or-32-byte-secret

# Meta (Facebook Login + Instagram Graph API) — Sprint 7/10
# Required for real Instagram Business + Facebook Page OAuth. Register the
# redirect URI in Meta Developer Console: Facebook Login → Valid OAuth
# Redirect URIs. Everything goes live immediately once these three are set —
# no code changes needed.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/oauth/meta/callback
META_GRAPH_VERSION=v22.0
# Legacy alias, still honored if set (META_REDIRECT_URI takes priority):
# META_OAUTH_REDIRECT_URI=http://localhost:3000/api/oauth/meta/callback
# Instagram requires a Professional (Business/Creator) account linked to a Facebook Page.
# Requested scopes: instagram_basic, instagram_content_publish, pages_show_list,
# pages_read_engagement, pages_manage_posts, business_management

# Sprint 10 — Mock Instagram/Facebook connect fallback.
# When META_APP_ID/META_APP_SECRET are missing, "Connect" simulates a successful
# connection instead of returning a 503, so scheduling/dashboard can be exercised
# without real Meta credentials. Enabled by default outside production.
# In production, mock connect is blocked unless explicitly set to true.
ALLOW_MOCK_CONNECT=false

# YouTube (Google OAuth) — placeholders until credentials are available
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URI=http://localhost:3000/api/oauth/youtube/callback

# LinkedIn OAuth — placeholders until credentials are available
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_OAUTH_REDIRECT_URI=http://localhost:3000/api/oauth/linkedin/callback

# X (Twitter) OAuth 2.0 — placeholders until credentials are available
X_CLIENT_ID=
X_CLIENT_SECRET=
X_OAUTH_REDIRECT_URI=http://localhost:3000/api/oauth/x/callback

# TikTok / Pinterest — Sprint 10 foundation only. Platforms are registered in
# the OAuth architecture (routes, DB, UI show "Coming soon") but provider
# implementations are not built yet. No env vars needed until that sprint.

# OpenAI (backend only — never expose to the frontend)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_OUTPUT_TOKENS=700
AI_RATE_LIMIT=20

# Publish queue worker (Sprint 8 — production Meta publish)
ENABLE_PUBLISH_WORKER=true
PUBLISH_WORKER_INTERVAL_MS=5000
PUBLISH_WORKER_BATCH_SIZE=10
# mock | meta-live | auto
# Production blocks mock unless ALLOW_MOCK_PUBLISH=true
PUBLISH_ADAPTER=auto
ALLOW_MOCK_PUBLISH=false
MOCK_PUBLISH_DELAY_MS=400
MOCK_PUBLISH_FAIL_RATE=0

# Sprint 9 — Billing (Stripe)
# Create a Product + recurring Price in Stripe Dashboard, then set:
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_GENESIS=
# Enforce paid access for AI generate + schedule. Default: true in production.
BILLING_ENFORCE=false
# Comma-separated emails with unpaid access + founder admin overview
FOUNDER_ADMIN_EMAILS=

# Transactional email (Resend). Without key, emails log to console in development.
RESEND_API_KEY=
EMAIL_FROM=Project Alpha <onboarding@resend.dev>
