generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Core authenticated account (Sprint 2 foundation)
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  company      String   @default("")
  timezone     String   @default("UTC")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  connectedAccounts ConnectedAccount[]
  scheduledPosts    ScheduledPost[]
  drafts            Draft[]
  oauthStates       OAuthState[]

  @@index([createdAt])
}

model ConnectedAccount {
  id                 String    @id @default(cuid())
  userId             String
  platform           String
  accountId          String
  accountName        String
  accountUsername    String    @default("")
  accessTokenEnc     String
  refreshTokenEnc    String    @default("")
  tokenExpiresAt     DateTime?
  pageId             String    @default("")
  pageAccessTokenEnc String    @default("")
  scopes             String    @default("")
  metadataJson       String    @default("{}")
  connectedAt        DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform, accountId])
  @@index([userId, platform])
}

model ScheduledPost {
  id          String   @id @default(cuid())
  userId      String
  platform    String
  caption     String
  mediaUrl    String   @default("")
  scheduledAt DateTime
  status      String   @default("scheduled")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, scheduledAt])
}

/// Saved AI-generated content drafts (Sprint 3)
model Draft {
  id           String    @id @default(cuid())
  userId       String
  platform     String
  contentGoal  String
  tone         String
  topic        String
  audience     String    @default("")
  language     String    @default("en")
  caption      String
  hashtags     String
  shortHook    String    @default("")
  callToAction String    @default("")
  generatedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model OAuthState {
  id        String   @id @default(cuid())
  userId    String
  platform  String
  state     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
