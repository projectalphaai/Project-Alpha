generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Core authenticated account
/// role: owner | admin | member (RBAC)
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  company      String   @default("")
  timezone     String   @default("UTC")
  role         String   @default("owner")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  connectedAccounts ConnectedAccount[]
  scheduledPosts    ScheduledPost[]
  drafts            Draft[]
  oauthStates       OAuthState[]
  activityLogs      ActivityLog[]

  @@index([createdAt])
}

model ConnectedAccount {
  id                 String    @id @default(cuid())
  userId             String
  platform           String
  accountId          String
  accountName        String
  accountUsername    String    @default("")
  accessTokenEnc     String
  refreshTokenEnc    String    @default("")
  tokenExpiresAt     DateTime?
  pageId             String    @default("")
  pageAccessTokenEnc String    @default("")
  scopes             String    @default("")
  metadataJson       String    @default("{}")
  /// active | expired | revoked
  status             String    @default("active")
  reconnectRequired  Boolean   @default(false)
  lastRefreshedAt    DateTime?
  lastValidatedAt    DateTime?
  connectedAt        DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform, accountId])
  @@index([userId, platform])
  @@index([userId, status])
}

/// Scheduler + publishing queue (Sprint 4)
model ScheduledPost {
  id             String    @id @default(cuid())
  userId         String
  platform       String
  caption        String
  mediaUrl       String    @default("")
  scheduledAt    DateTime
  status         String    @default("scheduled")
  errorMessage   String    @default("")
  attemptCount   Int       @default(0)
  maxAttempts    Int       @default(3)
  lastAttemptAt  DateTime?
  publishedAt    DateTime?
  externalPostId String    @default("")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityLogs ActivityLog[]

  @@index([userId, scheduledAt])
  @@index([status, scheduledAt])
  @@index([userId, status])
}

model Draft {
  id           String    @id @default(cuid())
  userId       String
  platform     String
  contentGoal  String
  tone         String
  topic        String
  audience     String    @default("")
  language     String    @default("en")
  caption      String
  hashtags     String
  shortHook    String    @default("")
  callToAction String    @default("")
  generatedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model OAuthState {
  id          String   @id @default(cuid())
  userId      String
  platform    String
  state       String   @unique
  /// connect | reconnect
  mode        String   @default("connect")
  codeVerifier String  @default("")
  metaJson    String   @default("{}")
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  postId    String?
  type      String
  message   String
  metaJson  String   @default("{}")
  createdAt DateTime @default(now())

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  post ScheduledPost? @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([postId])
}
