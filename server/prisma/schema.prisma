generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Core authenticated account
/// role: owner | admin | member (RBAC)
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  company      String   @default("")
  timezone     String   @default("UTC")
  role         String   @default("owner")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  connectedAccounts ConnectedAccount[]
  scheduledPosts    ScheduledPost[]
  drafts            Draft[]
  oauthStates       OAuthState[]
  activityLogs      ActivityLog[]
  ownedLeads        Lead[]              @relation("LeadWorkspace")
  assignedLeads     Lead[]              @relation("LeadOwner")
  leadNotes         LeadNote[]

  @@index([createdAt])
}

model ConnectedAccount {
  id                 String    @id @default(cuid())
  userId             String
  platform           String
  accountId          String
  accountName        String
  accountUsername    String    @default("")
  accessTokenEnc     String
  refreshTokenEnc    String    @default("")
  tokenExpiresAt     DateTime?
  pageId             String    @default("")
  pageAccessTokenEnc String    @default("")
  scopes             String    @default("")
  metadataJson       String    @default("{}")
  status             String    @default("active")
  reconnectRequired  Boolean   @default(false)
  lastRefreshedAt    DateTime?
  lastValidatedAt    DateTime?
  connectedAt        DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform, accountId])
  @@index([userId, platform])
  @@index([userId, status])
}

model ScheduledPost {
  id             String    @id @default(cuid())
  userId         String
  platform       String
  caption        String
  mediaUrl       String    @default("")
  scheduledAt    DateTime
  status         String    @default("scheduled")
  errorMessage   String    @default("")
  attemptCount   Int       @default(0)
  maxAttempts    Int       @default(3)
  lastAttemptAt  DateTime?
  publishedAt    DateTime?
  externalPostId String    @default("")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityLogs ActivityLog[]

  @@index([userId, scheduledAt])
  @@index([status, scheduledAt])
  @@index([userId, status])
}

model Draft {
  id           String    @id @default(cuid())
  userId       String
  platform     String
  contentGoal  String
  tone         String
  topic        String
  audience     String    @default("")
  language     String    @default("en")
  caption      String
  hashtags     String
  shortHook    String    @default("")
  callToAction String    @default("")
  generatedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model OAuthState {
  id           String   @id @default(cuid())
  userId       String
  platform     String
  state        String   @unique
  mode         String   @default("connect")
  codeVerifier String   @default("")
  metaJson     String   @default("{}")
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  postId    String?
  leadId    String?
  type      String
  message   String
  metaJson  String   @default("{}")
  createdAt DateTime @default(now())

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  post ScheduledPost? @relation(fields: [postId], references: [id], onDelete: SetNull)
  lead Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([postId])
  @@index([leadId])
}

/// CRM lead (Sprint 6)
/// stage: new | contacted | qualified | proposal | won | lost
model Lead {
  id              String    @id @default(cuid())
  userId          String
  ownerId         String?
  name            String
  email           String    @default("")
  phone           String    @default("")
  company         String    @default("")
  stage           String    @default("new")
  tagsJson        String    @default("[]")
  socialLinksJson String    @default("{}")
  followUpAt      DateTime?
  position        Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace    User                @relation("LeadWorkspace", fields: [userId], references: [id], onDelete: Cascade)
  owner        User?               @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  notes        LeadNote[]
  statusHistory LeadStatusHistory[]
  activityLogs ActivityLog[]

  @@index([userId, stage])
  @@index([userId, followUpAt])
  @@index([ownerId])
  @@index([userId, updatedAt])
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  userId    String
  body      String
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

model LeadStatusHistory {
  id         String   @id @default(cuid())
  leadId     String
  userId     String?
  fromStage  String
  toStage    String
  note       String   @default("")
  createdAt  DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}
